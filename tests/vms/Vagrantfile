Vagrant.configure("2") do |config|
  config.vm.box = "generic/debian12"
  config.vm.boot_timeout = 600
  config.ssh.insert_key = false
  config.vm.synced_folder "../..", "/vagrant", type: "rsync",
    rsync__auto: true,
    rsync__args: ["--archive", "--delete", "-z"]

  config.vm.provision "shell", path: "../../infra/provision/install-docker.sh"
  config.vm.provision "shell", path: "../../infra/provision/bootstrap-vm.sh"

  config.vm.provider :libvirt do |libvirt|
    libvirt.driver = "kvm"
    libvirt.cpu_mode = "host-passthrough"
    libvirt.qemu_use_session = false
    libvirt.storage_pool_name = "default"
    libvirt.management_network_name = "vagrant-libvirt"
    libvirt.management_network_address = "192.168.121.0/24"
  end

  config.vm.define "vm-01-data-core" do |vm|
    vm.vm.hostname = "vm-01-data-core"
    vm.vm.network "private_network", ip: "192.168.56.10"

    vm.vm.provider :libvirt do |libvirt|
      libvirt.memory = 8192
      libvirt.cpus = 6
      libvirt.storage :file, :size => "300G"
    end
  end

  config.vm.define "vm-02-app-query" do |vm|
    vm.vm.hostname = "vm-02-app-query"
    vm.vm.network "private_network", ip: "192.168.56.11"

    vm.vm.provider :libvirt do |libvirt|
      libvirt.memory = 6144
      libvirt.cpus = 4
      libvirt.storage :file, :size => "120G"
    end
  end

  config.vm.define "vm-03-ai-sandbox" do |vm|
    vm.vm.hostname = "vm-03-ai-sandbox"
    vm.vm.network "private_network", ip: "192.168.56.12"

    vm.vm.provider :libvirt do |libvirt|
      libvirt.memory = 4096
      libvirt.cpus = 2
      libvirt.storage :file, :size => "100G"
    end
  end
end